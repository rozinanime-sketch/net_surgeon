# Сборка
/target
/fuzz/target

# Находки и накопленный корпус фаззера: корпус полезен, но это сотни мелких
# файлов, которые растут с каждым прогоном. Падения (artifacts) забирайте
# из CI, там они сохраняются отдельным артефактом.
/fuzz/corpus
/fuzz/artifacts

# Недописанные файлы от атомарной записи (config/paths.rs): если процесс
# убили между записью и rename, такой файл остаётся рядом с настоящим.
.*.tmp

# Кэш выбранных стратегий — это состояние конкретной машины, а не исходник:
# программа создаёт его заново. Плюс в нём перечислены домены, которые с
# этой машины открывали, так что в публичный репозиторий ему не надо.
/strategies.txt

# Адрес воркера Cloudflare для Telegram — у каждого свой
telegram_relay.txt

# Какие новые домены уже предлагались для списков (config/list_updates.rs):
# состояние конкретной установки, а не исходник.
/.added_*

# Файлы релиза от ./release.sh
/dist
